# ── "Report a problem" (bug reports) ─────────────────────────────────────────
# Support inbox that receives every report (sent through AWS SES using SES_FROM_EMAIL + AWS_* keys).
BUG_REPORT_EMAIL=support@nurofin.com
# Chief of Staff integration. Leave COS_API_URL / COS_INTEGRATION_SECRET empty to skip forwarding (email still sent).
# COS_INTEGRATION_SECRET must equal BUILDTRACK_INTEGRATION_SECRET on the Chief of Staff server.
COS_API_URL=
COS_INTEGRATION_SECRET=
# Public URL of this API; Chief of Staff calls <BACKEND_URL>/api/bug-reports/cos-callback when an issue changes status.
BACKEND_URL=
# Local testing only: when SES is not configured, write each report email as a .eml file into this folder.
BUG_REPORT_EMAIL_DRYRUN_DIR=
